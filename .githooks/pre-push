#!/usr/bin/env bash
# Refuse a direct push to main: changes go through a branch and a pull
# request, merged by squash after the checks have passed. GitHub protects
# main as well; this hook catches the mistake before it reaches the server.
# Enable it once per clone:
#
#     git config core.hooksPath .githooks
#
# An empty remote accepts the repository's initial commit.
set -euo pipefail

protected='refs/heads/main'
while read -r _ _ remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ] && \
     [ "$remote_sha" != '0000000000000000000000000000000000000000' ]; then
    echo "Direct pushes to main are refused: push a branch and open a pull request." >&2
    echo "Merge it after the check and lean jobs of the workflow \"PDF and checks\" pass." >&2
    exit 1
  fi
done
exit 0
